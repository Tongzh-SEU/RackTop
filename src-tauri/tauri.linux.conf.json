{
  "$schema": "https://schema.tauri.app/config/2",
  "plugins": {
    "updater": {
      "endpoints": [
        "https://api.github.com/repos/Tongzh-SEU/RackTop/contents/latest.json?ref=updater",
        "https://raw.githubusercontent.com/Tongzh-SEU/RackTop/updater/latest.json"
      ]
    }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "RackTop",
        "dragDropEnabled": false,
        "width": 1320,
        "height": 820,
        "minWidth": 900,
        "minHeight": 620,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "shadow": true
      }
    ]
  },
  "bundle": {
    "targets": ["deb", "appimage"],
    "icon": [
      "icons/icon-linux.png",
      "icons/32x32-linux.png",
      "icons/128x128-linux.png",
      "icons/128x128@2x-linux.png"
    ],
    "linux": {
      "appimage": {
        "files": {
          "/usr/share/metainfo/com.racktop.desktop.metainfo.xml": "linux/com.racktop.desktop.metainfo.xml"
        }
      },
      "deb": {
        "depends": ["openssh-client", "xterm", "gnome-keyring"],
        "files": {
          "/usr/share/metainfo/com.racktop.desktop.metainfo.xml": "linux/com.racktop.desktop.metainfo.xml"
        }
      }
    }
  }
}
