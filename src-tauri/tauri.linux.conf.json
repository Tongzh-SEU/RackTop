{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "RackTop",
        "width": 1320,
        "height": 820,
        "minWidth": 900,
        "minHeight": 620,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "shadow": true
      }
    ]
  },
  "bundle": {
    "targets": ["deb", "appimage"],
    "icon": ["icons/linux.png"],
    "linux": {
      "deb": {
        "depends": ["openssh-client", "xterm", "gnome-keyring"]
      }
    }
  }
}
